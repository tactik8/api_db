{
  "name": "api_db",
  "version": "0.0.1",
  "description": "",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "build": "rm -rf dist && npm run build:cjs && npm run build:esm",
    "build:cjs": "esbuild src/server.js --bundle --packages=external --sourcemap --minify --platform=node --format=cjs --outfile=dist/index.cjs",
    "build:esm": "esbuild src/server.js --bundle --packages=external --sourcemap --minify --platform=node --format=esm --outfile=dist/index.js",
    "dev": "node src/server.js",
    "start": "node src/server.js",
    "d": "npm install github:tactik8/helpers_jsonld; npm install github:tactik8/helpers_mongodb;"
  },
  "keywords": [],
  "author": "Tactik8",
  "license": "ISC",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jest": "^30.4.2"
  },
  "dependencies": {
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.12.3",
    "helpers_jsonld": "github:tactik8/helpers_jsonld",
    "helpers_mongodb": "github:tactik8/helpers_mongodb"
  }
}
